# Yerelde kopyala: copy .env.example .env
# Üretimde aynı anahtarları Vercel ortam değişkenlerine ekle.

AUTH_SECRET="uzun-rastgele-bir-deger"
AUTH_URL="http://localhost:3000"

# Docker Compose db servisi bu şifreyi kullanır. Boşsa yerel yedek değer geçerlidir.
# POSTGRES_PASSWORD="change-me"

# Postgres (Neon, Vercel Postgres veya Compose dışındaki bir sunucu).
# Compose içindeki uygulama DATABASE_URL değerini kendisi kurar.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/hacettepe?schema=public&connect_timeout=5"

# Google OAuth. Yetkili yönlendirme: http://localhost:3000/api/auth/callback/google
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# Magic link. Örnek: smtp://USER:PASS@smtp.ornek.com:587
# EMAIL_SERVER=""
# EMAIL_FROM="Hacettepe Takas <takas@hacettepe.edu.tr>"

# Vercel Blob. İlan ve profil görselleri bu token ile yüklenir.
# BLOB_READ_WRITE_TOKEN=""
