// Hacettepe takas platformu
// E-posta kuralı (@hacettepe.edu.tr) veritabanında değil, NextAuth signIn
// callback'inde zorunlu tutulur. Prisma sonek kontrolü ifade edemez.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth v5) — magic link + Google OAuth
// Alan adları adapter'ın prisma.user / account / session / verificationToken
// çağrılarıyla birebir eşleşmeli.
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  /// İletişim için isteğe bağlı Instagram kullanıcı adı (başında @ olmadan).
  instagramHandle   String?
  preferredContact  ContactMethod @default(EMAIL)

  accounts       Account[]
  sessions       Session[]
  authenticators Authenticator[]

  items          Item[]
  comments       Comment[]
  offersSent     Offer[]   @relation("OffersSent")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Auth.js WebAuthn adapter metotları için. Passkey kullanılmayacaksa tablo boş kalır.
model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

// ---------------------------------------------------------------------------
// Takas
// ---------------------------------------------------------------------------

model Item {
  id          String        @id @default(cuid())
  title       String
  description String        @db.Text
  category    ItemCategory
  condition   ItemCondition
  /// Vercel Blob bağlanana kadar URL listesi. Boş dizi yer tutucu galeri demektir.
  images      String[]      @default([])

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  comments Comment[]
  offers   Offer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([ownerId])
  @@index([createdAt])
}

model Comment {
  id      String @id @default(cuid())
  body    String @db.Text

  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([itemId])
  @@index([authorId])
}

model Offer {
  id      String      @id @default(cuid())
  /// Teklif metni: ne verdiğini ve koşulları yazar.
  message String      @db.Text
  status  OfferStatus @default(PENDING)

  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation("OffersSent", fields: [senderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([itemId])
  @@index([senderId])
  @@index([status])
}

enum ContactMethod {
  EMAIL
  INSTAGRAM
}

enum ItemCondition {
  AZ_KULLANILMIS   @map("Az Kullanılmış")
  ORTA_KULLANILMIS @map("Orta Kullanılmış")
  COK_KULLANILMIS  @map("Çok Kullanılmış")
  YENI_GIBI        @map("Yeni Gibi")
}

enum ItemCategory {
  KITAP       @map("Kitap")
  ELEKTRONIK  @map("Elektronik")
  GIYIM       @map("Giyim")
  EV_ESYASI   @map("Ev Eşyası")
  SPOR        @map("Spor")
  KIRTASIYE   @map("Kırtasiye")
  DIGER       @map("Diğer")
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}
